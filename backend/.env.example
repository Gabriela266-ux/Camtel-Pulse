PORT=5000
NODE_ENV=development

# SQLite local : le fichier est créé par les migrations et n'est jamais versionné.
DB_STORAGE=./camtel_pulse.db

JWT_SECRET=change_this_secret_key
JWT_REFRESH_SECRET=change_this_refresh_secret
JWT_EXPIRES_IN=8h
JWT_REFRESH_EXPIRES_IN=30d

ACCOUNT_REQUEST_WINDOW_HOURS=72
CORRECTION_WINDOW_HOURS=48
MAX_ACTIVE_ADMINS=5
MAX_REALISATION_EDITS=5

FRONTEND_URL=http://localhost:5173

# Access-request decision notifications (optional in development).
EMAIL_MODE=development
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=notifications@example.com
SMTP_PASSWORD=change_me
SMTP_FROM=notifications@example.com
