PORT=5000
NODE_ENV=development
DB_DIALECT=sqlite
DB_POOL_MAX=30
DB_POOL_MIN=5
DB_POOL_ACQUIRE=30000
DB_POOL_IDLE=10000

# SQLite local : le fichier est créé par les migrations et n'est jamais versionné.
DB_STORAGE=./camtel_pulse.db

JWT_SECRET=change_this_secret_key
JWT_REFRESH_SECRET=change_this_refresh_secret
JWT_EXPIRES_IN=8h
JWT_REFRESH_EXPIRES_IN=30d

ACCOUNT_REQUEST_WINDOW_HOURS=72
CORRECTION_WINDOW_HOURS=48
MAX_ACTIVE_ADMINS=5
MAX_REALISATION_EDITS=5

FRONTEND_URL=http://localhost:5173

# Shared state for horizontally scaled production instances.
REDIS_ENABLED=false
REDIS_URL=redis://127.0.0.1:6379

JSON_LIMIT=1mb
IMPORT_JSON_LIMIT=10mb
URLENCODED_LIMIT=1mb
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=300
RATE_LIMIT_USER_MAX=120
TRUST_PROXY=1
REQUEST_TIMEOUT_MS=30000
IMPORT_TIMEOUT_MS=300000

# Access-request decision notifications (optional in development).
EMAIL_MODE=development
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=notifications@example.com
SMTP_PASSWORD=change_me
SMTP_FROM=notifications@example.com
